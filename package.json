{
  "name": "noq-agent",
  "version": "1.0.0",
  "description": "noq-agent – Local AI coding agent CLI. Analyzes repos, answers code questions, edits files, runs commands.",
  "main": "dist/index.js",
  "bin": {
    "noq": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node src/index.ts",
    "dev:tui:opentui": "bun run src/opentui/index.tsx --session opentui-preview --mode build",
    "check:tui:opentui": "bun x tsc -p tsconfig.opentui.json --noEmit",
    "test": "node --test --require ts-node/register \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm run check:tui:opentui && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noQils/noq-agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/noQils/noq-agent/issues"
  },
  "homepage": "https://github.com/noQils/noq-agent#readme",
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^18.3.26",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@google/genai": "^2.0.1",
    "@opentui/core": "^0.2.16",
    "@opentui/solid": "^0.2.16",
    "axios": "^1.16.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "ollama": "^0.6.3",
    "openai": "^6.37.0",
    "solid-js": "1.9.12",
    "typescript": "^6.0.3"
  }
}
